      "title": "LR | Fit or Load and Verify Parameters",
      "text": "%spark\nrequire(preparedDataSignature == Seq(base_folder, import_limit.toString, fittingSample.toString, splitSeed.toString, trainFraction.toString).mkString(\"|\"),\n    \"Data settings changed. Re-run the Prepare Data paragraph before fitting.\")\n\n\nvar lr_model_file = new File(model_folder, group_name + \"_lr_model\")\nlr_model_file.getParentFile().mkdirs()\n\nif(!lr_model_file.exists()) {\n    System.out.println(\"File not available, generating fit: \" + lr_model_file.getAbsolutePath())\n    \n    var lr_classifier = new LogisticRegression().setMaxIter(lrMaxIter).setRegParam(lrRegParam).setElasticNetParam(lrElasticNetParam).setLabelCol(\"NEXT_STATUS\").setFeaturesCol(\"scaledFeatures\")\n    var lr_pipeline = new Pipeline().setStages(Array(assembler, lr_classifier))\n    val fitStarted = System.nanoTime()\n    var lrModelTmp = lr_pipeline.fit(df_train)\n    val fitSeconds = (System.nanoTime() - fitStarted) / 1e9\n    lrModelTmp.save(lr_model_file.getAbsolutePath())\n    recordTraining(lrModelTmp, group_name + \"_lr\", fitSeconds)\n}\nelse {\n    System.out.println(\"Loading existing fit.\")\n}\n\n\nvar lrModel = PipelineModel.load(lr_model_file.getAbsolutePath())\n\n\n\nvar loadedLR = lrModel.stages.last.asInstanceOf[LogisticRegressionModel]\nrequire(loadedLR.getMaxIter == lrMaxIter && loadedLR.getRegParam == lrRegParam && loadedLR.getElasticNetParam == lrElasticNetParam,\n    \"Existing LR parameters differ from this experiment. Choose a NEW group name; the saved model was not overwritten.\")\nz.show(addModelDetails(spark.range(1).select(functions.lit(\"loaded and verified\").as(\"status\")), lrModel, group_name + \"_lr\"))\n",
