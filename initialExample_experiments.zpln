      "text": "%spark\nvar table_list = raw_list.map(x => (x.getString(0), x.getString(0))).toSeq.sorted\nrequire(table_list.nonEmpty, \"No evaluation results. Run the Write Evaluation paragraph first.\")\nvar regressorOptions = numericCols.map(x => (x, x)).toSeq\nvar selectedSeries = z.select(\"Series\", table_list).asInstanceOf[String]\nvar fallbackSeries = if (table_list.exists(_._1 == group_name + \"_lr_indist\")) group_name + \"_lr_indist\" else table_list.head._1\nvar dataset = if (table_list.exists(_._1 == selectedSeries)) selectedSeries else {\n    println(\"The previously selected Series no longer exists; displaying \" + fallbackSeries)\n    fallbackSeries\n}\nvar selectedRegressor = z.select(\"Regressor\", regressorOptions).asInstanceOf[String]\nval options = Seq((\"Percentile\", \"Percentile\"))\nval selected = z.checkbox(\"Options\", options)\nval use_percentile = selected.contains(\"Percentile\")\nvar df_display = createSummaryGraph(df_merged, use_percentile, selectedRegressor, dataset)\nvar df_display_avg = df_display.where(\"byAverage\")\nvar df_display_sum = df_display.where(\"NOT byAverage\")\nrequire(df_display_avg.take(1).nonEmpty, \"Selected Series has no rows. Select a current experiment.\")\nprintln(\"Displaying \" + dataset + \" by \" + selectedRegressor)\nz.run(\"paragraph_1695477110765_1997785957\")\nz.run(\"paragraph_1695477127942_2001658499\")\n",
