    {
      "title": "Project Settings | Base Folder and Group Name",
      "text": "%spark\n// Required controls: base folder and group name.\nvar base_folder = z.textbox(\"base folder\", \"<change me>\").asInstanceOf[String].trim\nvar group_name = z.textbox(\"group name\", \"group2_w2_exp06\").asInstanceOf[String].trim\nrequire(base_folder.nonEmpty && base_folder != \"<change me>\", \"Set base folder to your project directory.\")\nvar base_file = new File(base_folder).getCanonicalFile\nbase_folder = base_file.getAbsolutePath\nrequire(base_file.isDirectory, \"Base folder does not exist: \" + base_folder)\nrequire(new File(base_file, \"data/training_data\").isDirectory, \"Missing training data: \" + new File(base_file, \"data/training_data\"))\nrequire(group_name.matches(\"[A-Za-z0-9][A-Za-z0-9_-]*\"), \"Use letters, digits, underscores or hyphens for group name.\")\n\n// Saved models define their own parameters. No code edits or parameter matching are required to reuse them.\n// Known experiment suffixes reproduce the completed configurations when the models are absent.\nvar experimentPresets = Map(\n  \"baseline\" -> (100, 0.001, 0.001, 12, 6, 12345L),\n  \"exp02\" -> (100, 0.01, 0.001, 24, 6, 12345L),\n  \"exp03\" -> (100, 0.1, 0.001, 48, 6, 12345L),\n  \"exp04\" -> (100, 0.01, 0.5, 24, 4, 12345L),\n  \"exp05\" -> (100, 0.01, 1.0, 24, 8, 12345L),\n  \"exp06\" -> (100, 0.0001, 0.001, 48, 10, 12345L))\nvar presetKey = group_name.split(\"_\").last\nvar knownPreset = experimentPresets.get(presetKey)\nvar preset = knownPreset.getOrElse(experimentPresets(\"baseline\"))\nvar model_folder = new File(base_file, \"models\")\nvar configuredLRFile = new File(model_folder, group_name + \"_lr_model\")\nvar configuredRFFile = new File(model_folder, group_name + \"_rf_model\")\nvar savedLRSettings = if (configuredLRFile.exists) Some(PipelineModel.load(configuredLRFile.getAbsolutePath).stages.last.asInstanceOf[LogisticRegressionModel]) else None\nvar savedRFSettings = if (configuredRFFile.exists) Some(PipelineModel.load(configuredRFFile.getAbsolutePath).stages.last.asInstanceOf[RandomForestClassificationModel]) else None\n\n// Optional controls appear only for a NEW custom name without a known preset.\nvar lrMaxIter = savedLRSettings.map(_.getMaxIter).getOrElse(if (knownPreset.isDefined) preset._1 else z.textbox(\"New LR maxIter\", preset._1.toString).asInstanceOf[String].trim.toInt)\nvar lrRegParam = savedLRSettings.map(_.getRegParam).getOrElse(if (knownPreset.isDefined) preset._2 else z.textbox(\"New LR regParam\", preset._2.toString).asInstanceOf[String].trim.toDouble)\nvar lrElasticNetParam = savedLRSettings.map(_.getElasticNetParam).getOrElse(if (knownPreset.isDefined) preset._3 else z.textbox(\"New LR elasticNetParam\", preset._3.toString).asInstanceOf[String].trim.toDouble)\nvar rfNumTrees = savedRFSettings.map(_.getNumTrees).getOrElse(if (knownPreset.isDefined) preset._4 else z.textbox(\"New RF numTrees\", preset._4.toString).asInstanceOf[String].trim.toInt)\nvar rfMaxDepth = savedRFSettings.map(_.getMaxDepth).getOrElse(if (knownPreset.isDefined) preset._5 else z.textbox(\"New RF maxDepth\", preset._5.toString).asInstanceOf[String].trim.toInt)\nvar rfSeed = savedRFSettings.map(_.getSeed).getOrElse(if (knownPreset.isDefined) preset._6 else z.textbox(\"New RF seed\", preset._6.toString).asInstanceOf[String].trim.toLong)\n\n// Fixed data settings for the assignment experiments.\nvar import_limit = 1000000\nvar fittingSample = 500000\nvar splitSeed = 12345L\nvar trainFraction = 0.25\nvar merged_file = new File(base_file, \"results/experiments_v1/df_merged\")\nvar summary_file = new File(base_file, \"results/experiments_v1/df_summary\")\nrequire(lrMaxIter > 0 && lrRegParam >= 0 && !lrRegParam.isNaN && !lrRegParam.isInfinity)\nrequire(lrElasticNetParam >= 0 && lrElasticNetParam <= 1)\nrequire(rfNumTrees > 0 && rfMaxDepth >= 0 && rfMaxDepth <= 30)\nprintln(\"Experiment: \" + group_name)\nprintln(\"LR settings source: \" + (if (savedLRSettings.isDefined) \"saved model\" else if (knownPreset.isDefined) \"experiment preset\" else \"optional interface controls\"))\nprintln(\"RF settings source: \" + (if (savedRFSettings.isDefined) \"saved model\" else if (knownPreset.isDefined) \"experiment preset\" else \"optional interface controls\"))\nprintln(s\"LR: maxIter=$lrMaxIter, regParam=$lrRegParam, elasticNetParam=$lrElasticNetParam\")\nprintln(s\"RF: numTrees=$rfNumTrees, maxDepth=$rfMaxDepth, seed=$rfSeed\")\nprintln(\"Training data: \" + new File(base_file, \"data/training_data\"))\nprintln(\"Models: \" + model_folder)\nprintln(\"Results: \" + summary_file.getParentFile)\nprintln(\"Existing models are reused with their saved settings. Use a new group name to fit new parameters.\")\n",
      "user": "anonymous",
      
      "progress": 0,
