    {
      "title": "Prepare Data | Shared Split for All Experiments",
      "text": "%spark\n\nval enumCols = SortedSet[String]() ++ Array(\"OCCUPANCY_STATUS\", \"FIRSTTIME_BUYER\", \"TERM\", \"UNIT_COUNT\", \"PREPAYMENT_PENALTY\")\nval numericCols = SortedSet[String]() ++ Array(\"AGE\", \"MTM_LTV\", \"INCENTIVE\", \"CREDIT_SCORE\", \"MI_PERCENT\", \"ORIG_CLTV\", \"ORIG_DTI\", \"ORIG_UPB\", \"ORIG_INTRATE\")\n\n// There are about 10MM items in the dataset, you can use only the first few million if you have trouble processing them all. \n// import_limit is configured in the experiment settings paragraph.\n\nvar df_raw : DataFrame = convertBoolColumns(filterData(spark.read.parquet(base_folder + \"/data/training_data\").limit(import_limit)), enumCols.toArray)\n\nprintln(\"Loaded raw, converted boolean columns.\")\n\n// For now, just allow all features. \nval featureList = Array(\"OCCUPANCY_STATUS\", \"FIRSTTIME_BUYER\", \"TERM\", \"UNIT_COUNT\", \"PREPAYMENT_PENALTY\", \"AGE\", \"MTM_LTV\", \"INCENTIVE\", \"CREDIT_SCORE\", \"MI_PERCENT\", \"ORIG_CLTV\", \"ORIG_DTI\", \"ORIG_UPB\", \"ORIG_INTRATE\");\n// fittingSample is configured in the experiment settings paragraph.\n\n// Random split; fittingSample is only an upper limit, not a target count. \nvar Array(df_train, df_test) = df_raw.randomSplit(Array(trainFraction, 1.0 - trainFraction), seed=splitSeed);\n\n// Randomize the order of the training data. \n// This is small enough that we can pretty easily cache the whole thing.\ndf_train = df_train.orderBy(functions.rand(splitSeed)).limit(fittingSample).persist();\ndf_test = df_test.persist()\n\nprintln(\"Generating encoders\")\nvar binaryCols = new ListBuffer[String]();\nvar pipeline = generateEncoders(df_train, enumCols.toArray);\nprintln(\"Generated encoders\")\n\ndf_train = applyEncoders(df_train, pipeline, binaryCols);\ndf_test = applyEncoders(df_test, pipeline, binaryCols);\n\nprintln(\"Applied encoders\")\n\nval assembler = generateAssembler(df_train, featureList);\n\nprintln(\"Generated assembler\")\n\nprintln(\"Cols: \" + binaryCols)\n\n\n// Retain a signature so later parameter-only runs cannot silently change data settings.\nvar preparedDataSignature = Seq(base_folder, import_limit.toString, fittingSample.toString, splitSeed.toString, trainFraction.toString).mkString(\"|\")\nprintln(\"Training rows: \" + df_train.count() + \"; test rows: \" + df_test.count())\n",
