      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "HTML",
            "data": "<div class=\"markdown-body\">\n<h2>Fit LR and RF Models</h2>\n\n</div>"
          }
        ]
      },
      "apps": [],
      "runtimeInfos": {},
      "progressUpdateIntervalMs": 500,
      "jobName": "paragraph_1790719484496_465235980",
      "id": "paragraph_1581102965511_1259643645",
      
      
      
      "status": "FINISHED"
    },
    {
      "title": "Summary and Training Records | Actual Model Parameters",
      "text": "%spark\n// Capture the actual settings of the saved/loaded classifier.\ndef addModelDetails(df: DataFrame, model: PipelineModel, modelName: String): DataFrame = {\n    var out = df.withColumn(\"model_name\", functions.lit(modelName))\n      .withColumn(\"model_path\", functions.lit(new File(new File(base_folder, \"models\"), modelName + \"_model\").getAbsolutePath))\n      .withColumn(\"lr_max_iter\", functions.lit(null).cast(\"int\"))\n      .withColumn(\"lr_reg_param\", functions.lit(null).cast(\"double\"))\n      .withColumn(\"lr_elastic_net_param\", functions.lit(null).cast(\"double\"))\n      .withColumn(\"rf_num_trees\", functions.lit(null).cast(\"int\"))\n      .withColumn(\"rf_max_depth\", functions.lit(null).cast(\"int\"))\n      .withColumn(\"rf_seed\", functions.lit(null).cast(\"long\"))\n    model.stages.last match {\n      case m: LogisticRegressionModel =>\n        out = out.withColumn(\"model_kind\", functions.lit(\"LR\"))\n          .withColumn(\"lr_max_iter\", functions.lit(m.getMaxIter))\n          .withColumn(\"lr_reg_param\", functions.lit(m.getRegParam))\n          .withColumn(\"lr_elastic_net_param\", functions.lit(m.getElasticNetParam))\n      case m: RandomForestClassificationModel =>\n        out = out.withColumn(\"model_kind\", functions.lit(\"RF\"))\n          .withColumn(\"rf_num_trees\", functions.lit(m.getNumTrees))\n          .withColumn(\"rf_max_depth\", functions.lit(m.getMaxDepth))\n          .withColumn(\"rf_seed\", functions.lit(m.getSeed))\n      case _ => throw new IllegalArgumentException(\"Unsupported classifier in pipeline\")\n    }\n    out\n}\n\ndef recordTraining(model: PipelineModel, modelName: String, fitSeconds: Double): Unit = {\n    var record = addModelDetails(spark.range(1).select(functions.lit(group_name).as(\"experiment_name\")), model, modelName)\n      .withColumn(\"training_rows\", functions.lit(df_train.count()))\n      .withColumn(\"test_rows\", functions.lit(df_test.count()))\n      .withColumn(\"fit_seconds\", functions.lit(fitSeconds))\n      .withColumn(\"import_limit\", functions.lit(import_limit))\n      .withColumn(\"fitting_sample_limit\", functions.lit(fittingSample))\n      .withColumn(\"split_seed\", functions.lit(splitSeed))\n      .withColumn(\"train_fraction\", functions.lit(trainFraction))\n      .withColumn(\"feature_list\", functions.lit(featureList.sorted.mkString(\",\")))\n      .withColumn(\"spark_version\", functions.lit(sc.version))\n      .withColumn(\"trained_at\", functions.current_timestamp())\n    // A separate JSON directory; never alter the Spark model directory.\n    val destination = new File(new File(base_folder, \"models\"), modelName + \"_training_info\")\n    record.coalesce(1).write.mode(\"errorifexists\").json(destination.getAbsolutePath)\n    println(\"Training record: \" + destination.getAbsolutePath)\n}\n\n \n\ndef generate_summary(df_test : DataFrame, model : PipelineModel, tableName: String, evalName: String) : DataFrame = {\n    var results = testClassifier(df_test, model,tableName);\n    results = results.withColumn(\"eval_name\", functions.lit(evalName))\n    val summary = results.groupBy(\"table_name\", \"eval_name\").agg(\n        functions.count(\"*\").as(\"count\"), functions.avg(\"h_ug\").as(\"h_ug\"), functions.avg(\"h_fg\").as(\"h_fg\"), \n        functions.avg(\"prob_p\").as(\"prob_p\"), functions.avg(\"prob_c\").as(\"prob_c\"), functions.avg(\"prob_3\").as(\"prob_3\"), \n        functions.avg(\"actual_p\").as(\"actual_p\"), functions.avg(\"actual_c\").as(\"actual_c\"), functions.avg(\"actual_3\").as(\"actual_3\")\n        )\n    \n    return addModelDetails(summary, model, tableName)\n}\n\ndef summarize_assembled(df_train : DataFrame, df_test: DataFrame, model : PipelineModel, tableName: String) : DataFrame = {\n    val train_summary = generate_summary(df_train, model, tableName, \"insample\")\n    val test_summary = generate_summary(df_test, model, tableName, \"indist\")\n    val output = train_summary.union(test_summary).persist();\n    return output\n}\n",
      "user": "anonymous",
      
