    {
      "title": "Optional Comparison | Historical exp05 RF vs exp06 RF",
      "text": "%spark\n// Compare the two strongest RF candidates on exactly the same held-out observations.\nvar comparisonRF5 = \"group2_w2_exp05_rf_indist\"\nvar comparisonRF6 = \"group2_w2_exp06_rf_indist\"\nvar availableComparisonSeries = if (merged_file.isDirectory) spark.read.parquet(merged_file.getAbsolutePath()).select(\"table_name\").distinct().collect().map(_.getString(0)).toSet else Set.empty[String]\nif (!availableComparisonSeries.contains(comparisonRF5) || !availableComparisonSeries.contains(comparisonRF6)) {\n  println(\"Historical exp05/exp06 comparison skipped: both saved evaluation series are required. Run those experiments to regenerate the comparison.\")\n} else {\nvar comparisonSource = spark.read.parquet(merged_file.getAbsolutePath())\n  .filter(functions.col(\"table_name\").isin(comparisonRF5, comparisonRF6))\nvar comparisonFeatures = Array(\"MTM_LTV\", \"CREDIT_SCORE\", \"INCENTIVE\", \"AGE\")\nfor (feature <- comparisonFeatures) {\n  val p5 = functions.col(\"table_name\") === comparisonRF5\n  val p6 = functions.col(\"table_name\") === comparisonRF6\n  val rows = comparisonSource.groupBy(feature + \"_percentile\").agg(\n    functions.avg(feature).as(\"feature_value\"),\n    functions.sum(functions.when(p5, 1).otherwise(0)).as(\"count_exp05\"),\n    functions.sum(functions.when(p6, 1).otherwise(0)).as(\"count_exp06\"),\n    functions.avg(\"actual_p\").as(\"observed_p\"), functions.avg(\"actual_3\").as(\"observed_3\"),\n    functions.avg(functions.when(p5, functions.col(\"prob_p\"))).as(\"exp05_p\"),\n    functions.avg(functions.when(p6, functions.col(\"prob_p\"))).as(\"exp06_p\"),\n    functions.avg(functions.when(p5, functions.col(\"prob_3\"))).as(\"exp05_3\"),\n    functions.avg(functions.when(p6, functions.col(\"prob_3\"))).as(\"exp06_3\"),\n    functions.avg(functions.when(p5, functions.col(\"h_fg\"))).as(\"exp05_loss\"),\n    functions.avg(functions.when(p6, functions.col(\"h_fg\"))).as(\"exp06_loss\"))\n    .withColumnRenamed(feature + \"_percentile\", \"percentile\")\n    .withColumn(\"feature\", functions.lit(feature))\n    .orderBy(\"percentile\")\n  println(\"Feature comparison: \" + feature)\n  z.show(rows)\n}\n\n}\n",
