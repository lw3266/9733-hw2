    {
      "text": "%spark\n\nimport org.apache.spark.sql.expressions.Window\n\ndef process_merged(df_merged : DataFrame, numericCols : SortedSet[String]) : DataFrame = {\n    var keepColumns = featureList\n    keepColumns = keepColumns ++ Array[String](\"table_name\", \"prob_p\", \"prob_3\", \"actual_p\", \"actual_3\", \"h_ug\", \"h_fg\")\n    \n    var df_processed = df_merged.select(keepColumns.map(m=>functions.col(m)):_*)\n    \n    df_processed = df_processed.withColumn(\"INCENTIVE\", functions.expr(\"100 * INCENTIVE\"))\n\n    for(numericCol <- numericCols) {\n        System.out.println(\"Adding quantiles for \" + numericCol)\n        val windowSpec  = Window.partitionBy(\"table_name\").orderBy(numericCol)\n        df_processed = df_processed.withColumn(numericCol, functions.expr(\"ROUND(\" + numericCol + \", 2)\"))\n        df_processed = df_processed.withColumn(numericCol + \"_percentile\", functions.percent_rank().over(windowSpec))\n        df_processed = df_processed.withColumn(numericCol + \"_percentile\", functions.expr(\"ROUND(\" + numericCol + \"_percentile, 2)\"))\n    }\n    \n    //df_merged = df_merged.persist()\n    return df_processed\n}\n\ndef createSummaryGraph(df_merged : DataFrame, use_percentile : Boolean, col : String, dataset : String) : DataFrame = {\n    var df_display = df_merged.where(\"table_name = '\" + dataset + \"'\")\n        //.where(col + \"_percentile > 0 AND \" + col + \"_percentile < 0.99\")\n\n    var reg_col = col\n\n    df_display = df_display.withColumn(\"regressor\", functions.col(reg_col))\n    df_display = df_display.withColumn(\"regressor_percentile\", functions.col(reg_col + \"_percentile\"))\n\n    \n    // if(use_percentile) {\n    //     reg_col = reg_col + \"_percentile\"\n    // }\n    \n    // df_display = df_display.withColumn(\"regressor\", functions.col(reg_col))\n    df_display = df_display.select(\"regressor\", \"regressor_percentile\", \"prob_p\", \"actual_p\", \"prob_3\", \"actual_3\", \"h_ug\", \"h_fg\")\n    \n    //if(use_average) {\n    var df_display_avg = df_display.groupBy(\"regressor_percentile\").agg(\n        functions.avg(\"regressor\").as(\"regressor\"),\n        functions.mean(\"prob_p\").as(\"prob_p\"),\n        functions.mean(\"actual_p\").as(\"actual_p\"),\n        functions.mean(\"prob_3\").as(\"prob_3\"),\n        functions.mean(\"actual_3\").as(\"actual_3\"),\n        functions.mean(\"h_ug\").as(\"h_ug\"),\n        functions.mean(\"h_fg\").as(\"h_fg\"),\n        functions.count(\"regressor\").as(\"count\"))\n    //}\n    //else {\n    var df_display_sum = df_display.groupBy(\"regressor_percentile\").agg(\n        functions.avg(\"regressor\").as(\"regressor\"),\n        functions.sum(\"prob_p\").as(\"prob_p\"),\n        functions.sum(\"actual_p\").as(\"actual_p\"),\n        functions.sum(\"prob_3\").as(\"prob_3\"),\n        functions.sum(\"actual_3\").as(\"actual_3\"),\n        functions.sum(\"h_ug\").as(\"h_ug\"),\n        functions.sum(\"h_fg\").as(\"h_fg\"),\n        functions.count(\"regressor\").as(\"count\"))\n    //}\n\n    \n    \n    \n    df_display_avg = df_display_avg.withColumn(\"byAverage\", functions.lit(true))\n    df_display_sum = df_display_sum.withColumn(\"byAverage\", functions.lit(false))\n    var df_output = df_display_avg.unionByName(df_display_sum).orderBy(\"regressor\", \"byAverage\").persist()\n\n    if(use_percentile) {\n        df_output = df_output.withColumn(\"regressor\", functions.col(\"regressor_percentile\"))\n    }\n    \n    df_output = df_output.drop(\"regressor_percentile\").orderBy(\"regressor\")\n\n\n    //df_output = df_output.withColumn(\"table_name\", functions.lit(dataset))\n    //df_output = df_output.withColumn(\"byPercentile\", functions.lit(use_percentile))\n    //df_output = df_output.withColumn(\"columnName\", functions.lit(col))\n    \n\n    return df_output\n}\n\n\n\n\n\n\ndef process_and_write(df_merged : DataFrame, merged_file : File, numericCols : SortedSet[String]) = {\n    var df_processed = process_merged(df_merged, numericCols);\n    df_processed.repartition(8).write.mode(\"append\").partitionBy(\"table_name\").option(\"compression\", \"zstd\").parquet(merged_file.getAbsolutePath())\n}\n\ndef update_evaluation(df_raw : DataFrame, model : PipelineModel, tableName: String, merged_file : File, numericCols : SortedSet[String]) = {\n    var computed = testClassifier(df_raw, model, tableName);\n    \n    var table_file: File = new File(merged_file, \"table_name=\" + tableName)\n    \n    // Delete the data if it already exists.\n    if(table_file.exists()) {\n        println(\"Deleting existing data: \" + table_file.getAbsolutePath())\n        import org.apache.commons.io.FileUtils;\n        FileUtils.forceDelete(table_file);\n    }\n    \n    process_and_write(computed, merged_file, numericCols);\n}\n\ndef update_summary(df_train : DataFrame, df_test : DataFrame, model : PipelineModel, tableName: String, summary_file : File) = {\n    var df_combined = summarize_assembled(df_train, df_test, model,tableName)\n    \n    var table_file: File = new File(summary_file, \"table_name=\" + tableName)\n    \n    // Delete the data if it already exists.\n    if(table_file.exists()) {\n        println(\"Deleting existing data: \" + table_file.getAbsolutePath())\n        import org.apache.commons.io.FileUtils;\n        FileUtils.forceDelete(table_file);\n    }\n    \n    df_combined.coalesce(1).write.mode(\"append\").partitionBy(\"table_name\").option(\"compression\", \"zstd\").parquet(summary_file.getAbsolutePath())\n}\n\n",
      "user": "anonymous",
      
