    {
      "title": "Current Group | RF Reload Verification",
      "text": "%spark\n// Verify the current group's saved RF using paths derived from Project Settings.\nvar submissionCandidatePath = new File(model_folder, group_name + \"_rf_model\").getAbsolutePath\nif (!new File(submissionCandidatePath).isDirectory) {\n  println(\"RF reload verification skipped: no RF model exists for this group. Run the RF paragraph first.\")\n} else {\n  var submissionCandidate = PipelineModel.load(submissionCandidatePath)\n  var submissionClassifier = submissionCandidate.stages.last.asInstanceOf[RandomForestClassificationModel]\n  var candidateReloadCheck = convertProbArray(submissionCandidate.transform(df_test.limit(1000)), \"candidate_reload_check\")\n  var candidateReloadRows = candidateReloadCheck.count()\n  require(candidateReloadRows > 0, \"No held-out rows available for verification\")\n  var invalidProbabilities = candidateReloadCheck.filter(functions.expr(\"prob_array IS NULL OR size(prob_array) != 3 OR prob_array[0] IS NULL OR prob_array[1] IS NULL OR prob_array[2] IS NULL OR prob_array[0] < 0 OR prob_array[1] < 0 OR prob_array[2] < 0 OR prob_array[0] > 1 OR prob_array[1] > 1 OR prob_array[2] > 1 OR abs(prob_array[0] + prob_array[1] + prob_array[2] - 1.0) > 0.000001\")).count()\n  require(invalidProbabilities == 0, \"Invalid probabilities after reload\")\n  z.show(candidateReloadCheck.select(\"NEXT_STATUS\", \"prediction\", \"prob_array\").limit(10))\n  println(s\"Verified disk reload for $group_name: ${submissionClassifier.getNumTrees} trees, depth ${submissionClassifier.getMaxDepth}, ${submissionClassifier.numFeatures} features; $candidateReloadRows valid predictions.\")\n  println(\"Loaded from: \" + submissionCandidatePath)\n}\n",
      "user": "anonymous",
      
