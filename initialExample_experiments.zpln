    {
      "title": "Write Evaluation | Preserve Experiments and Update Matching Results",
      "text": "%spark\n// Prevent old in-memory models from being labelled as a new experiment.\nrequire(preparedDataSignature == Seq(base_folder, import_limit.toString, fittingSample.toString, splitSeed.toString, trainFraction.toString).mkString(\"|\"), \"Data settings changed; prepare data again.\")\nrequire(lr_model_file.getAbsolutePath == new File(new File(base_folder, \"models\"), group_name + \"_lr_model\").getAbsolutePath &&\n        rf_model_file.getAbsolutePath == new File(new File(base_folder, \"models\"), group_name + \"_rf_model\").getAbsolutePath,\n        \"Run both LR and RF paragraphs for this experiment before writing evaluation.\")\nrequire(loadedLR.getMaxIter == lrMaxIter && loadedLR.getRegParam == lrRegParam && loadedLR.getElasticNetParam == lrElasticNetParam &&\n        loadedRF.getNumTrees == rfNumTrees && loadedRF.getMaxDepth == rfMaxDepth && loadedRF.getSeed == rfSeed,\n        \"Model parameters differ from current settings. Use a new name and run both model paragraphs.\")\n\nvar merged_file = new File(base_folder + \"/results/experiments_v1/df_merged\")\nvar summary_file = new File(base_folder + \"/results/experiments_v1/df_summary\")\n\nmerged_file.getParentFile().mkdirs()\nsummary_file.getParentFile().mkdirs()\n\n// N.B: We can limit the test dataset size in the evaluation to avoid making tables that are too big.\nupdate_evaluation(df_train, lrModel,  group_name + \"_lr_insample\", merged_file, numericCols)\nupdate_evaluation(df_test, lrModel,  group_name + \"_lr_indist\", merged_file, numericCols)\n\nupdate_evaluation(df_train, rf_model,  group_name + \"_rf_insample\", merged_file, numericCols)\nupdate_evaluation(df_test, rf_model,  group_name + \"_rf_indist\", merged_file, numericCols)\n\nupdate_summary(df_train, df_test, lrModel,  group_name + \"_lr\", summary_file)\nupdate_summary(df_train, df_test, rf_model,  group_name + \"_rf\", summary_file)\n",
