      "title": "RF | Fit or Load and Verify Parameters",
      "text": "%spark\nrequire(preparedDataSignature == Seq(base_folder, import_limit.toString, fittingSample.toString, splitSeed.toString, trainFraction.toString).mkString(\"|\"),\n    \"Data settings changed. Re-run the Prepare Data paragraph before fitting.\")\n\n\nvar rf_model_file = new File(model_folder, group_name + \"_rf_model\")\n\nif(!rf_model_file.exists()) {\n    System.out.println(\"File not available, generating fit.\")\n    var rf_classifier = new RandomForestClassifier().setSeed(rfSeed).setNumTrees(rfNumTrees).setMaxDepth(rfMaxDepth)\n    rf_classifier = rf_classifier.setLabelCol(\"NEXT_STATUS\").setFeaturesCol(\"scaledFeatures\")\n    var rf_pipeline = new Pipeline().setStages(Array(assembler, rf_classifier))\n    val fitStarted = System.nanoTime()\n    var rf_model = rf_pipeline.fit(df_train)\n    val fitSeconds = (System.nanoTime() - fitStarted) / 1e9\n    rf_model.save(rf_model_file.getAbsolutePath())\n    recordTraining(rf_model, group_name + \"_rf\", fitSeconds)\n}\nelse {\n    System.out.println(\"Loading existing fit.\")\n}\n\nvar rf_model = PipelineModel.load(rf_model_file.getAbsolutePath())\nvar loadedRF = rf_model.stages.last.asInstanceOf[RandomForestClassificationModel]\nrequire(loadedRF.getNumTrees == rfNumTrees && loadedRF.getMaxDepth == rfMaxDepth && loadedRF.getSeed == rfSeed,\n    \"Existing RF parameters differ from this experiment. Choose a NEW group name; the saved model was not overwritten.\")\nz.show(addModelDetails(spark.range(1).select(functions.lit(\"loaded and verified\").as(\"status\")), rf_model, group_name + \"_rf\"))\n",
