{"paragraphs":[{"text":"%md\n\n## Now do all the imports to set up the code we will use later. ","user":"anonymous","dateUpdated":"2025-09-10T23:09:36-0400","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029801_113464532","id":"paragraph_1581101569861_-3615636","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:09:36-0400","dateFinished":"2025-09-10T23:09:36-0400","status":"FINISHED","focus":true},{"text":"%spark\n\nimport org.apache.spark.SparkContext\nimport org.apache.spark.ml.classification.{RandomForestClassificationModel, RandomForestClassifier}\nimport org.apache.spark.ml.classification.LogisticRegression\nimport org.apache.spark.ml.classification.LogisticRegressionModel\nimport org.apache.spark.ml.feature.VectorAssembler\nimport org.apache.spark.ml.feature.StandardScaler\nimport org.apache.spark.ml.linalg.Vectors\nimport org.apache.spark.ml.linalg.DenseVector\nimport org.apache.spark.sql.functions.udf\nimport org.apache.spark.sql.functions\nimport org.apache.spark.sql.types.BooleanType;\nimport org.apache.spark.sql.DataFrame\nimport org.apache.spark.ml.classification.MultilayerPerceptronClassifier\nimport scala.collection.JavaConversions._\nimport scala.collection.JavaConverters._\nimport org.apache.spark.storage.StorageLevel\nimport scala.collection.immutable.TreeSet;\nimport scala.collection.mutable.SortedSet;\nimport scala.collection.GenSeq;\n\nimport scala.collection.mutable.ListBuffer;\nimport org.apache.spark.ml.PipelineModel;\nimport org.apache.spark.ml.PipelineStage;\nimport org.apache.spark.ml.Pipeline;\nimport org.apache.spark.ml.feature.OneHotEncoder;\nimport org.apache.spark.ml.feature.StringIndexer;\nimport org.apache.spark.ml.feature.StringIndexerModel;\nimport org.apache.spark.ml.linalg.Vector;\n\nimport org.apache.spark.ml.classification.ProbabilisticClassificationModel;\nimport org.apache.spark.ml.classification.ProbabilisticClassifier;\n\nimport java.io.File\n","user":"anonymous","dateUpdated":"2025-09-10T23:09:36-0400","progress":0,"config":{"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/scala","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029801_17217145","id":"20190901-214828_1404103962","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:09:36-0400","dateFinished":"2025-09-10T23:09:47-0400","status":"FINISHED"},{"text":"%md\n\n## print versions","user":"anonymous","dateUpdated":"2025-09-10T23:09:47-0400","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_394086819","id":"paragraph_1581101605549_1368121879","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:09:47-0400","dateFinished":"2025-09-10T23:09:47-0400","status":"FINISHED"},{"text":"%spark\n\n// Print versions.\n\nprintln(\"Scala version: \" + util.Properties.versionString);\nprintln(\"Spark version: \" + sc.version);\nprintln(\"Java version: \" + System.getProperty(\"java.version\"))","user":"anonymous","dateUpdated":"2025-09-10T23:09:47-0400","progress":0,"config":{"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/scala","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_1664921331","id":"paragraph_1581101457251_-797425847","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:09:47-0400","dateFinished":"2025-09-10T23:09:47-0400","status":"FINISHED"},{"text":"%md\n\n## Assemble functions to be used later. \n","user":"anonymous","dateUpdated":"2025-09-10T23:09:47-0400","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_259754588","id":"paragraph_1581101615996_-681301057","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:09:47-0400","dateFinished":"2025-09-10T23:09:47-0400","status":"FINISHED"},{"text":"%spark\n\nval b2d = (x:Boolean) => if(x) 1.0 else 0.0\nval b2dUdf = udf(b2d);\n\ndef filterData (raw : DataFrame) : DataFrame = {\n    var df_filtered = raw.filter($\"MTM_LTV\" > 0.0).filter($\"MTM_LTV\" < 2.0);\n    df_filtered = df_filtered.filter($\"INCENTIVE\" > -1.0).filter($\"CREDIT_SCORE\" > 0);\n    df_filtered = df_filtered.filter($\"NEXT_STATUS\" >= 0).filter($\"NEXT_STATUS\" <= 2);\n    df_filtered = df_filtered.filter($\"AGE\" >= 0).filter($\"STATUS\" === 1);\n    df_filtered = df_filtered.filter($\"TERM\" >= 0);\n    df_filtered = df_filtered.filter($\"MI_PERCENT\" >= 0);\n    df_filtered = df_filtered.filter($\"UNIT_COUNT\" >= 0);\n    df_filtered = df_filtered.filter($\"ORIG_LTV\" >= 0);\n    df_filtered = df_filtered.filter($\"ORIG_CLTV\" >= 0);\n    df_filtered = df_filtered.filter($\"ORIG_DTI\" >= 0);\n    df_filtered = df_filtered.filter($\"ORIG_UPB\" >= 0);\n    df_filtered = df_filtered.filter($\"ORIG_INTRATE\" >= 0);\n    df_filtered = df_filtered.filter($\"CREDIT_SCORE\" <= 900);\n    \n    // Go ahead and add the status columns here. \n    df_filtered = df_filtered.withColumn(\"actual_p\", expr(\" case when next_status = 0 then 1.0 else 0.0 end\"));\n    df_filtered = df_filtered.withColumn(\"actual_c\", expr(\" case when next_status = 1 then 1.0 else 0.0 end\"));\n    df_filtered = df_filtered.withColumn(\"actual_3\", expr(\" case when next_status = 2 then 1.0 else 0.0 end\"));\n    \n    return df_filtered;\n};\n\ndef convertBoolColumns(data: DataFrame, enumColumns: Array[String]) : DataFrame = {\n    var d2 = data;\n    val type_map = data.dtypes.groupBy(_._1).map { case (k,v) => (k,v.map(_._2))};\n    \n    for(cname <- enumColumns) {\n        if(type_map(cname)(0).equals(\"BooleanType\")) {\n            // We need to convert this to a string type. \n            d2 = d2.withColumn(cname, b2dUdf(col(cname))); \n        }\n    }\n    \n    return d2;\n}\n\n    ","user":"anonymous","dateUpdated":"2025-09-10T23:09:47-0400","progress":0,"config":{"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/scala","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_1183038938","id":"paragraph_1599510568867_323362381","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:09:47-0400","dateFinished":"2025-09-10T23:09:49-0400","status":"FINISHED"},{"text":"%spark\n\n\n// This function generates the appropriate encoders for a dataframe. \ndef generateEncoders(data: DataFrame, enumColumns: Array[String]) : PipelineModel = {\n    val indexCols = enumColumns.map((s:String) => s + \"_Index\")\n    val vecCols = enumColumns.map((s:String) => s + \"_Vec\")\n    var stages  = new ListBuffer[PipelineStage]();\n    \n    for(i <- 0 to indexCols.length - 1) {\n        val strCol = enumColumns(i);\n        val indexCol = indexCols(i);\n        val vecCol = vecCols(i);\n\n        \n        var indexer = new StringIndexer().setInputCol(strCol).setOutputCol(indexCol)\n        .setStringOrderType(\"frequencyAsc\");\n        stages.append(indexer);\n    }\n    \n    var onehot = new OneHotEncoder().setInputCols(indexCols).setOutputCols(vecCols).setDropLast(true);\n    stages.append(onehot);\n    \n    val pipeline = new Pipeline()\n        .setStages(stages.toArray)\n    \n    return pipeline.fit(data);\n}\n\n\ndef applyEncoders(data: DataFrame, model: PipelineModel, binaryCols : ListBuffer[String]) : DataFrame = {\n    binaryCols.clear();\n    var df_output = model.transform(data);\n    \n    val vToA: Any => Array[Double] = _.asInstanceOf[Vector].toArray\n    val vToAUdf = udf(vToA);\n    \n    \n    for(next <- model.stages) {\n        if(next.isInstanceOf[StringIndexerModel]) {\n            // Add a column for each potential value. \n            var indexer = next.asInstanceOf[StringIndexerModel]\n            val labels = indexer.labels;\n            val inputCol = indexer.getInputCol;\n            \n            for(i <- 0 to labels.length - 2) {\n                val labelName = labels(i).replaceAll(\"[^a-zA-Z0-9_]\", \"_\");\n                val colName = (inputCol + \"_\" + labelName);\n                \n                df_output = df_output.withColumn(colName, element_at(vToAUdf(col(inputCol + \"_Vec\")), 1 + i))\n                binaryCols += colName;\n            }\n        }\n    }\n    \n    return df_output;\n    }\n","user":"anonymous","dateUpdated":"2025-09-10T23:09:49-0400","progress":0,"config":{"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/scala","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_890188871","id":"paragraph_1600054785496_1602018759","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:09:49-0400","dateFinished":"2025-09-10T23:09:49-0400","status":"FINISHED"},{"text":"%spark\n\nimport org.apache.spark.ml.functions.vector_to_array\nimport org.apache.spark.ml.Estimator\n\n// Super ugly. The Probability array is a DenseVector, and basically none of the functions work on it. \ndef convertProbArray (raw : DataFrame, table_name : String) : DataFrame = {\n    return raw.withColumn(\"prob_array\",vector_to_array(functions.col(\"probability\")));\n};\n\ndef expandColumns (raw : DataFrame, table_name : String) : DataFrame = {\n    var expanded = convertProbArray(raw, table_name);\n    \n    val distEntropy = (x: GenSeq[Double]) => {\n        var sum = 0.0;\n        \n        for(next <- x) {\n            if(next > 0) {\n                sum = sum + (next*Math.log(next))\n            }\n        }\n        \n         -1.0 * sum    \n    }\n    \n    val deUdf = udf(distEntropy)\n    \n    // Now split out the probabilities.\n    expanded = expanded.withColumn(\"prob_p\", element_at($\"prob_array\", 1)).withColumn(\"prob_c\",element_at($\"prob_array\", 2)).withColumn(\"prob_3\", element_at($\"prob_array\", 3));\n    expanded = expanded.withColumn(\"h_g\", deUdf(col(\"prob_array\")));\n    expanded = expanded.withColumn(\"h_fg\", expr(\" -1.0 * log(prob_array[next_status])\"));\n    expanded = expanded.withColumn(\"table_name\", functions.lit(table_name));\n\n    expanded.registerTempTable(table_name);\n    return expanded;\n};\n\ndef testClassifier (df_test : DataFrame, model : PipelineModel, tableName: String) : DataFrame = {\n    return expandColumns(model.transform(df_test),tableName);\n}\n\n","user":"anonymous","dateUpdated":"2025-09-10T23:09:49-0400","progress":0,"config":{"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/scala","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_885282330","id":"paragraph_1600052426018_1796860954","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:09:49-0400","dateFinished":"2025-09-10T23:09:50-0400","status":"FINISHED"},{"text":"%spark\n\ndef generateAssembler(data: DataFrame, featureCols: Array[String]) : PipelineModel = {\n    var features = SortedSet[String]()\n    \n    for(next <- featureCols) {\n        if(data.columns.contains(next)) {\n            features += next;\n        }\n        else if(data.columns.contains(next + \"_Vec\")) {\n            features += (next + \"_Vec\");\n        }\n        else {\n            throw new IllegalArgumentException(\"Invalid column: \" + next);\n        }\n    }\n\n    val assembler = new VectorAssembler().\n      setInputCols(features.toArray).\n      setOutputCol(\"features\")\n    \n    val scaler = new StandardScaler()\n      .setInputCol(\"features\")\n      .setOutputCol(\"scaledFeatures\")\n      .setWithStd(true)\n      .setWithMean(true)\n\n    val pipeline = new Pipeline()\n        .setStages(Array[PipelineStage](assembler, scaler));\n    \n    return pipeline.fit(data); \n}\n\n\n","user":"anonymous","dateUpdated":"2025-09-10T23:09:50-0400","progress":0,"config":{"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/scala","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_1175135068","id":"paragraph_1600049936573_77673247","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:09:50-0400","dateFinished":"2025-09-10T23:09:50-0400","status":"FINISHED"},{"text":"%md\n\n## Load the Data","user":"anonymous","dateUpdated":"2025-09-10T23:09:50-0400","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_803070434","id":"paragraph_1695410514732_742287635","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:09:50-0400","dateFinished":"2025-09-10T23:09:50-0400","status":"FINISHED"},{"text":"%spark\n\nvar base_folder: String = z.textbox(\"base folder\", \"<change me>\").asInstanceOf[String]\nvar group_name = z.textbox(\"group name\", \"<change me>\")\n\nvar base_file = new File(base_folder)\n\nif(!base_file.isDirectory()) {\n    throw new RuntimeException(\"Base folder needs to exist: \" + base_file.getAbsolutePath())\n}\n","user":"anonymous","dateUpdated":"2025-09-10T23:09:50-0400","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/scala","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{"base folder":"/Users/tyler/sync-workspace/nyu_class/2025H2","group name":"baseline"},"forms":{"base folder":{"type":"TextBox","name":"base folder","displayName":"base folder","defaultValue":"<change me>","hidden":false},"group name":{"type":"TextBox","name":"group name","displayName":"group name","defaultValue":"<change me>","hidden":false}}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_460678272","id":"paragraph_1707354140632_1173782790","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:09:50-0400","dateFinished":"2025-09-10T23:09:50-0400","status":"FINISHED"},{"text":"%spark\n\nval enumCols = SortedSet[String]() ++ Array(\"OCCUPANCY_STATUS\", \"FIRSTTIME_BUYER\", \"TERM\", \"UNIT_COUNT\", \"PREPAYMENT_PENALTY\")\nval numericCols = SortedSet[String]() ++ Array(\"AGE\", \"MTM_LTV\", \"INCENTIVE\", \"CREDIT_SCORE\", \"MI_PERCENT\", \"ORIG_CLTV\", \"ORIG_DTI\", \"ORIG_UPB\", \"ORIG_INTRATE\")\n\n// There are about 10MM items in the dataset, you can use only the first few million if you have trouble processing them all. \nvar import_limit = 1 * 1000 * 1000\n\nvar df_raw : DataFrame = convertBoolColumns(filterData(spark.read.parquet(base_folder + \"/data/training_data\").limit(import_limit)), enumCols.toArray)\n\nprintln(\"Loaded raw, converted boolean columns.\")\n\n// For now, just allow all features. \nval featureList = Array(\"OCCUPANCY_STATUS\", \"FIRSTTIME_BUYER\", \"TERM\", \"UNIT_COUNT\", \"PREPAYMENT_PENALTY\", \"AGE\", \"MTM_LTV\", \"INCENTIVE\", \"CREDIT_SCORE\", \"MI_PERCENT\", \"ORIG_CLTV\", \"ORIG_DTI\", \"ORIG_UPB\", \"ORIG_INTRATE\");\nval fittingSample : Int = 500 * 1000;\n\n// Split these, allocating about 500k observations for training. \nvar Array(df_train, df_test) = df_raw.randomSplit(Array(0.25, 0.75), seed=12345);\n\n// Randomize the order of the training data. \n// This is small enough that we can pretty easily cache the whole thing.\ndf_train = df_train.orderBy(rand()).limit(fittingSample).persist();\ndf_test = df_test.persist()\n\nprintln(\"Generating encoders\")\nvar binaryCols = new ListBuffer[String]();\nvar pipeline = generateEncoders(df_train, enumCols.toArray);\nprintln(\"Generated encoders\")\n\ndf_train = applyEncoders(df_train, pipeline, binaryCols);\ndf_test = applyEncoders(df_test, pipeline, binaryCols);\n\nprintln(\"Applied encoders\")\n\nval assembler = generateAssembler(df_train, featureList);\n\nprintln(\"Generated assembler\")\n\nprintln(\"Cols: \" + binaryCols)\n\n","user":"anonymous","dateUpdated":"2025-09-10T23:09:50-0400","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/scala","fontSize":9,"editorHide":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=0"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=1"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=2"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=3"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=4"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=5"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=6"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=7"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=8"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_2005810037","id":"paragraph_1599511173298_1623899819","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:09:50-0400","dateFinished":"2025-09-10T23:10:05-0400","status":"FINISHED"},{"text":"%spark\n\nprint(df_train.count())","user":"anonymous","dateUpdated":"2025-09-10T23:10:05-0400","progress":0,"config":{"colWidth":12,"editorMode":"ace/mode/scala","fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=9"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_154220450","id":"paragraph_1726014369674_1660551408","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:10:05-0400","dateFinished":"2025-09-10T23:10:05-0400","status":"FINISHED"},{"text":"%spark\n\nz.show(df_train.limit(10))","user":"anonymous","dateUpdated":"2025-09-10T23:10:05-0400","progress":5,"config":{"colWidth":12,"editorMode":"ace/mode/scala","fontSize":9,"results":{"0":{"graph":{"mode":"table","height":300,"optionOpen":false,"setting":{"table":{"tableGridState":{"columns":[{"name":"ID0","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"SEQUENCE_NUMBER1","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"SOURCE2","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"AGE3","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"CREDIT_SCORE4","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"STATUS5","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"NEXT_STATUS6","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"FIRSTTIME_BUYER7","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"TERM8","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"MI_PERCENT9","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"UNIT_COUNT10","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"OCCUPANCY_STATUS11","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"ORIG_CLTV12","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"ORIG_DTI13","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"ORIG_UPB14","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"ORIG_LTV15","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"ORIG_INTRATE16","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"CHANNEL17","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"PRODUCT_TYPE18","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"PROPERTY_STATE19","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"PROPERTY_TYPE20","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"PREPAYMENT_PENALTY21","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"LOAN_PURPOSE22","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"UPB23","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"MTM_LTV24","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"INCENTIVE25","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"ORIGINATION_DATE26","visible":true,"width":259,"sort":{},"filters":[{}],"pinned":""},{"name":"FACTOR_DATE27","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"ORIGINATION_YEAR28","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"actual_p29","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"actual_c30","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"actual_331","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"FIRSTTIME_BUYER_Index32","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"OCCUPANCY_STATUS_Index33","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"PREPAYMENT_PENALTY_Index34","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"TERM_Index35","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"UNIT_COUNT_Index36","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"FIRSTTIME_BUYER_Vec37","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"OCCUPANCY_STATUS_Vec38","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"PREPAYMENT_PENALTY_Vec39","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"TERM_Vec40","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"UNIT_COUNT_Vec41","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"FIRSTTIME_BUYER_1_042","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"OCCUPANCY_STATUS_143","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"OCCUPANCY_STATUS_244","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"PREPAYMENT_PENALTY_1_045","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"TERM_18046","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"UNIT_COUNT_9947","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"UNIT_COUNT_448","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"UNIT_COUNT_349","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""},{"name":"UNIT_COUNT_250","visible":true,"width":"*","sort":{},"filters":[{}],"pinned":""}],"scrollFocus":{},"selection":[],"grouping":{"grouping":[],"aggregations":[],"rowExpandedStates":{}},"treeView":{},"pagination":{"paginationCurrentPage":1,"paginationPageSize":250}},"tableColumnTypeState":{"names":{"ID":"string","SEQUENCE_NUMBER":"string","SOURCE":"string","AGE":"string","CREDIT_SCORE":"string","STATUS":"string","NEXT_STATUS":"string","FIRSTTIME_BUYER":"string","TERM":"string","MI_PERCENT":"string","UNIT_COUNT":"string","OCCUPANCY_STATUS":"string","ORIG_CLTV":"string","ORIG_DTI":"string","ORIG_UPB":"string","ORIG_LTV":"string","ORIG_INTRATE":"string","CHANNEL":"string","PRODUCT_TYPE":"string","PROPERTY_STATE":"string","PROPERTY_TYPE":"string","PREPAYMENT_PENALTY":"string","LOAN_PURPOSE":"string","UPB":"string","MTM_LTV":"string","INCENTIVE":"string","ORIGINATION_DATE":"string","FACTOR_DATE":"string","ORIGINATION_YEAR":"string","actual_p":"string","actual_c":"string","actual_3":"string","FIRSTTIME_BUYER_Index":"string","OCCUPANCY_STATUS_Index":"string","PREPAYMENT_PENALTY_Index":"string","TERM_Index":"string","UNIT_COUNT_Index":"string","FIRSTTIME_BUYER_Vec":"string","OCCUPANCY_STATUS_Vec":"string","PREPAYMENT_PENALTY_Vec":"string","TERM_Vec":"string","UNIT_COUNT_Vec":"string","FIRSTTIME_BUYER_1_0":"string","OCCUPANCY_STATUS_1":"string","OCCUPANCY_STATUS_2":"string","PREPAYMENT_PENALTY_1_0":"string","TERM_180":"string","UNIT_COUNT_99":"string","UNIT_COUNT_4":"string","UNIT_COUNT_3":"string","UNIT_COUNT_2":"string"},"updated":false},"tableOptionSpecHash":"[{\"name\":\"useFilter\",\"valueType\":\"boolean\",\"defaultValue\":false,\"widget\":\"checkbox\",\"description\":\"Enable filter for columns\"},{\"name\":\"showPagination\",\"valueType\":\"boolean\",\"defaultValue\":false,\"widget\":\"checkbox\",\"description\":\"Enable pagination for better navigation\"},{\"name\":\"showAggregationFooter\",\"valueType\":\"boolean\",\"defaultValue\":false,\"widget\":\"checkbox\",\"description\":\"Enable a footer for displaying aggregated values\"}]","tableOptionValue":{"useFilter":false,"showPagination":false,"showAggregationFooter":false},"updated":false,"initialized":false}},"commonSetting":{}}}},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=10"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_490152425","id":"paragraph_1695692207298_1604413900","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:10:05-0400","dateFinished":"2025-09-10T23:10:06-0400","status":"FINISHED"},{"text":"%md\n\n## Fit LR and RF Models\n","user":"anonymous","dateUpdated":"2025-09-10T23:10:06-0400","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_1718119089","id":"paragraph_1581102965511_1259643645","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:10:06-0400","dateFinished":"2025-09-10T23:10:06-0400","status":"FINISHED"},{"text":"%spark \n\ndef generate_summary(df_test : DataFrame, model : PipelineModel, tableName: String, evalName: String) : DataFrame = {\n    var results = testClassifier(df_test, model,tableName);\n    results = results.withColumn(\"eval_name\", functions.lit(evalName))\n    val summary = results.groupBy(\"table_name\", \"eval_name\").agg(\n        functions.count(\"*\").as(\"count\"), functions.avg(\"h_g\").as(\"h_g\"), functions.avg(\"h_fg\").as(\"h_fg\"), \n        functions.avg(\"prob_p\").as(\"prob_p\"), functions.avg(\"prob_c\").as(\"prob_c\"), functions.avg(\"prob_3\").as(\"prob_3\"), \n        functions.avg(\"actual_p\").as(\"actual_p\"), functions.avg(\"actual_c\").as(\"actual_c\"), functions.avg(\"actual_3\").as(\"actual_3\")\n        )\n    \n    return summary\n}\n\ndef summarize_assembled(df_train : DataFrame, df_test: DataFrame, model : PipelineModel, tableName: String) : DataFrame = {\n    val train_summary = generate_summary(df_train, model, tableName, \"insample\")\n    val test_summary = generate_summary(df_test, model, tableName, \"indist\")\n    val output = train_summary.union(test_summary).persist();\n    return output\n}\n\n","user":"anonymous","dateUpdated":"2025-09-10T23:10:06-0400","progress":0,"config":{"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/scala","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_1300983796","id":"paragraph_1602469450953_1225430460","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:10:06-0400","dateFinished":"2025-09-10T23:10:06-0400","status":"FINISHED"},{"text":"%md\n\n## LR Model","user":"anonymous","dateUpdated":"2025-09-10T23:10:06-0400","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_41001050","id":"paragraph_1695410996777_975373060","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:10:06-0400","dateFinished":"2025-09-10T23:10:06-0400","status":"FINISHED"},{"text":"%spark\n\nvar model_folder = new File(base_folder, \"models\")\nmodel_folder.mkdirs()\n","user":"anonymous","dateUpdated":"2025-09-10T23:10:06-0400","progress":0,"config":{"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/scala","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_387263932","id":"paragraph_1707588537993_2121396699","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:10:06-0400","dateFinished":"2025-09-10T23:10:07-0400","status":"FINISHED"},{"text":"%spark\n\nvar lr_model_file = new File(model_folder, group_name + \"_lr_model\")\nlr_model_file.getParentFile().mkdirs()\n\nif(!lr_model_file.exists()) {\n    System.out.println(\"File not available, generating fit: \" + lr_model_file.getAbsolutePath())\n    \n    var lr_classifier = new LogisticRegression().setMaxIter(100).setRegParam(0.001).setElasticNetParam(0.001).setLabelCol(\"NEXT_STATUS\").setFeaturesCol(\"scaledFeatures\")\n    var lr_pipeline = new Pipeline().setStages(Array(assembler, lr_classifier))\n    var lrModelTmp = lr_pipeline.fit(df_train)\n    lrModelTmp.save(lr_model_file.getAbsolutePath())\n}\nelse {\n    System.out.println(\"Loading existing fit.\")\n}\n\n\nvar lrModel = PipelineModel.load(lr_model_file.getAbsolutePath())\n\n\n","user":"anonymous","dateUpdated":"2025-09-10T23:10:07-0400","progress":100,"config":{"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/scala","fontSize":9,"editorHide":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=11"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=12"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=13"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=14"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=15"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=16"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=17"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=18"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=19"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=20"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=21"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=22"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=23"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_641468324","id":"paragraph_1600053538146_178814384","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:10:07-0400","dateFinished":"2025-09-10T23:10:09-0400","status":"FINISHED"},{"text":"%md\n\n## RF Model","user":"anonymous","dateUpdated":"2025-09-10T23:10:09-0400","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_493165378","id":"paragraph_1695411019338_1441054772","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:10:09-0400","dateFinished":"2025-09-10T23:10:09-0400","status":"FINISHED"},{"text":"%spark\n\nvar rf_model_file = new File(model_folder, group_name + \"_rf_model\")\n\nif(!rf_model_file.exists()) {\n    System.out.println(\"File not available, generating fit.\")\n    var rf_classifier = new RandomForestClassifier().setSeed(12345).setNumTrees(12).setMaxDepth(6)\n    rf_classifier = rf_classifier.setLabelCol(\"NEXT_STATUS\").setFeaturesCol(\"scaledFeatures\")\n    var rf_pipeline = new Pipeline().setStages(Array(assembler, rf_classifier))\n    var rf_model = rf_pipeline.fit(df_train)\n    rf_model.save(rf_model_file.getAbsolutePath())\n}\nelse {\n    System.out.println(\"Loading existing fit.\")\n}\n\nvar rf_model = PipelineModel.load(rf_model_file.getAbsolutePath())","user":"anonymous","dateUpdated":"2025-09-10T23:10:09-0400","progress":100,"config":{"colWidth":12,"editorMode":"ace/mode/scala","fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=24"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=25"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=26"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=27"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=28"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=29"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=30"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=31"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=32"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=33"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=34"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=35"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=36"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=37"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=38"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_84909842","id":"paragraph_1663637146021_12947026","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:10:09-0400","dateFinished":"2025-09-10T23:10:11-0400","status":"FINISHED"},{"text":"%md\n\n## Now apply the models to the various datasets, and analyze the results. \n","user":"anonymous","dateUpdated":"2025-09-10T23:10:11-0400","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionKey":"TAB","completionSupport":false},"colWidth":12,"editorMode":"ace/mode/markdown","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029802_903889866","id":"paragraph_1581103057527_-518692021","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:10:11-0400","dateFinished":"2025-09-10T23:10:11-0400","status":"FINISHED"},{"text":"%spark\n\nimport org.apache.spark.sql.expressions.Window\n\ndef process_merged(df_merged : DataFrame, numericCols : SortedSet[String]) : DataFrame = {\n    var keepColumns = featureList\n    keepColumns = keepColumns ++ Array[String](\"table_name\", \"prob_p\", \"prob_3\", \"actual_p\", \"actual_3\", \"h_g\", \"h_fg\")\n    \n    var df_processed = df_merged.select(keepColumns.map(m=>functions.col(m)):_*)\n    \n    df_processed = df_processed.withColumn(\"INCENTIVE\", functions.expr(\"100 * INCENTIVE\"))\n\n    for(numericCol <- numericCols) {\n        System.out.println(\"Adding quantiles for \" + numericCol)\n        val windowSpec  = Window.partitionBy(\"table_name\").orderBy(numericCol)\n        df_processed = df_processed.withColumn(numericCol, functions.expr(\"ROUND(\" + numericCol + \", 2)\"))\n        df_processed = df_processed.withColumn(numericCol + \"_percentile\", functions.percent_rank().over(windowSpec))\n        df_processed = df_processed.withColumn(numericCol + \"_percentile\", functions.expr(\"ROUND(\" + numericCol + \"_percentile, 2)\"))\n    }\n    \n    //df_merged = df_merged.persist()\n    return df_processed\n}\n\ndef createSummaryGraph(df_merged : DataFrame, use_percentile : Boolean, col : String, dataset : String) : DataFrame = {\n    var df_display = df_merged.where(\"table_name = '\" + dataset + \"'\")\n        //.where(col + \"_percentile > 0 AND \" + col + \"_percentile < 0.99\")\n\n    var reg_col = col\n\n    df_display = df_display.withColumn(\"regressor\", functions.col(reg_col))\n    df_display = df_display.withColumn(\"regressor_percentile\", functions.col(reg_col + \"_percentile\"))\n\n    \n    // if(use_percentile) {\n    //     reg_col = reg_col + \"_percentile\"\n    // }\n    \n    // df_display = df_display.withColumn(\"regressor\", functions.col(reg_col))\n    df_display = df_display.select(\"regressor\", \"regressor_percentile\", \"prob_p\", \"actual_p\", \"prob_3\", \"actual_3\", \"h_g\", \"h_fg\")\n    \n    //if(use_average) {\n    var df_display_avg = df_display.groupBy(\"regressor_percentile\").agg(\n        functions.avg(\"regressor\").as(\"regressor\"),\n        functions.mean(\"prob_p\").as(\"prob_p\"),\n        functions.mean(\"actual_p\").as(\"actual_p\"),\n        functions.mean(\"prob_3\").as(\"prob_3\"),\n        functions.mean(\"actual_3\").as(\"actual_3\"),\n        functions.mean(\"h_g\").as(\"h_g\"),\n        functions.mean(\"h_fg\").as(\"h_fg\"),\n        functions.count(\"regressor\").as(\"count\"))\n    //}\n    //else {\n    var df_display_sum = df_display.groupBy(\"regressor_percentile\").agg(\n        functions.avg(\"regressor\").as(\"regressor\"),\n        functions.sum(\"prob_p\").as(\"prob_p\"),\n        functions.sum(\"actual_p\").as(\"actual_p\"),\n        functions.sum(\"prob_3\").as(\"prob_3\"),\n        functions.sum(\"actual_3\").as(\"actual_3\"),\n        functions.sum(\"h_g\").as(\"h_g\"),\n        functions.sum(\"h_fg\").as(\"h_fg\"),\n        functions.count(\"regressor\").as(\"count\"))\n    //}\n\n    \n    \n    \n    df_display_avg = df_display_avg.withColumn(\"byAverage\", functions.lit(true))\n    df_display_sum = df_display_sum.withColumn(\"byAverage\", functions.lit(false))\n    var df_output = df_display_avg.unionByName(df_display_sum).orderBy(\"regressor\", \"byAverage\").persist()\n\n    if(use_percentile) {\n        df_output = df_output.withColumn(\"regressor\", functions.col(\"regressor_percentile\"))\n    }\n    \n    df_output = df_output.drop(\"regressor_percentile\").orderBy(\"regressor\")\n\n\n    //df_output = df_output.withColumn(\"table_name\", functions.lit(dataset))\n    //df_output = df_output.withColumn(\"byPercentile\", functions.lit(use_percentile))\n    //df_output = df_output.withColumn(\"columnName\", functions.lit(col))\n    \n\n    return df_output\n}\n\n\n\n\n\n\ndef process_and_write(df_merged : DataFrame, merged_file : File, numericCols : SortedSet[String]) = {\n    var df_processed = process_merged(df_merged, numericCols);\n    df_processed.repartition(8).write.mode(\"append\").partitionBy(\"table_name\").option(\"compression\", \"zstd\").parquet(merged_file.getAbsolutePath())\n}\n\ndef update_evaluation(df_raw : DataFrame, model : PipelineModel, tableName: String, merged_file : File, numericCols : SortedSet[String]) = {\n    var computed = testClassifier(df_raw, model, tableName);\n    \n    var table_file: File = new File(merged_file, \"table_name=\" + tableName)\n    \n    // Delete the data if it already exists.\n    if(table_file.exists()) {\n        println(\"Deleting existing data: \" + table_file.getAbsolutePath())\n        import org.apache.commons.io.FileUtils;\n        FileUtils.forceDelete(table_file);\n    }\n    \n    process_and_write(computed, merged_file, numericCols);\n}\n\ndef update_summary(df_train : DataFrame, df_test : DataFrame, model : PipelineModel, tableName: String, summary_file : File) = {\n    var df_combined = summarize_assembled(df_train, df_test, model,tableName)\n    \n    var table_file: File = new File(summary_file, \"table_name=\" + tableName)\n    \n    // Delete the data if it already exists.\n    if(table_file.exists()) {\n        println(\"Deleting existing data: \" + table_file.getAbsolutePath())\n        import org.apache.commons.io.FileUtils;\n        FileUtils.forceDelete(table_file);\n    }\n    \n    df_combined.coalesce(1).write.mode(\"append\").partitionBy(\"table_name\").option(\"compression\", \"zstd\").parquet(summary_file.getAbsolutePath())\n}\n\n","user":"anonymous","dateUpdated":"2025-09-10T23:10:11-0400","progress":0,"config":{"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/scala","fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029803_1306097264","id":"paragraph_1695745765924_1851172640","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:10:11-0400","dateFinished":"2025-09-10T23:10:11-0400","status":"FINISHED"},{"text":"%spark\n\nvar merged_file = new File(base_folder + \"/results/df_merged\")\nvar summary_file = new File(base_folder + \"/results/df_summary\")\n\nmerged_file.getParentFile().mkdirs()\nsummary_file.getParentFile().mkdirs()\n\n// N.B: We can limit the test dataset size in the evaluation to avoid making tables that are too big.\nupdate_evaluation(df_train, lrModel,  group_name + \"_lr_insample\", merged_file, numericCols)\nupdate_evaluation(df_test, lrModel,  group_name + \"_lr_indist\", merged_file, numericCols)\n\nupdate_evaluation(df_train, rf_model,  group_name + \"_rf_insample\", merged_file, numericCols)\nupdate_evaluation(df_test, rf_model,  group_name + \"_rf_indist\", merged_file, numericCols)\n\nupdate_summary(df_train, df_test, lrModel,  group_name + \"_lr\", summary_file)\nupdate_summary(df_train, df_test, rf_model,  group_name + \"_rf\", summary_file)\n","user":"anonymous","dateUpdated":"2025-09-10T23:10:11-0400","progress":0,"config":{"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true},"colWidth":12,"editorMode":"ace/mode/scala","fontSize":9,"editorHide":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=39"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=40"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=41"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=42"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=43"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=44"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=45"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=46"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=47"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=48"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=49"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=50"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=51"},{"jobUrl":"http://192.168.1.8:4040/jobs/job?id=52"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1757560029803_728213553","id":"paragraph_1707585690019_641257624","dateCreated":"2025-09-10T23:07:09-0400","dateStarted":"2025-09-10T23:10:11-0400","dateFinished":"2025-09-10T23:11:07-0400","status":"FINISHED"},{"text":"%spark\n\nvar df_merged = spark.read.parque